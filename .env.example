# Copy to .env to override defaults. Read by docker compose and by apps/api.
# Change DB_PORT / API_PORT / WEB_PORT if you run several factory projects at once.
DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=app
API_PORT=3000
WEB_PORT=5173
# better-auth. The secret signs session cookies: REQUIRED in production (generate with
# `openssl rand -base64 32`); a dev-only default is used otherwise.
# BETTER_AUTH_URL is the public origin users browse to; defaults to http://localhost:$WEB_PORT.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
